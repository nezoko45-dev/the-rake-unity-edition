{
  "name": "the-rake-unity-edition",
  "version": "1.1.0",
  "private": true,
  "description": "Three.js Rake survival game with multiplayer and AI",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server.js",
    "desktop": "electron .",
    "dist": "electron-builder --win portable"
  },
  "dependencies": {
    "express": "^5.1.0",
    "three": "^0.180.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "dev.nezoko45.therakeunity",
    "productName": "The Rake Unity Edition",
    "asar": true,
    "files": [
      "electron-main.js",
      "server.js",
      "public/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../Assets",
        "to": "Assets",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "The-Rake-Unity-Edition.exe"
    },
    "directories": {
      "output": "dist"
    }
  }
}
